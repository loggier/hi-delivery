# URL pública del panel. Se usa para el logo de los correos (/logo-hid.png).
# Si no existe, se usa la constante app.site_url.
APP_PUBLIC_URL=https://ejemplo.com

# Correo para notificaciones (canal `email`).
# Copia estas variables a `.env` y llena los valores reales. No subas `.env` a git.
SMTP_HOST=smtp.ejemplo.com
# 587 usa STARTTLS (SMTP_SECURE=false). 465 usa TLS directo (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@ejemplo.com
SMTP_PASSWORD=cambia-esta-clave
SMTP_FROM_EMAIL=notificaciones@ejemplo.com
SMTP_FROM_NAME=Hi Delivery

# Sesión de servidor del dueño de negocio (cookie firmada HMAC-SHA256, 12 h).
# Obligatoria para el login de dueño: sin ella el login responde error interno.
# Mínimo 32 caracteres. Genera un valor propio, p. ej. `openssl rand -hex 32`.
# No reutilices otros secretos ni subas el valor real a git.
OWNER_SESSION_SECRET=
